<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  

  <!-- Global Tool Packaging Properties -->
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>covpulse</ToolCommandName>
    <PackageId>CovPulse.Cli</PackageId>
    <Version>1.0.0</Version>
    <Title>CovPulse</Title>
    <Description>A CLI tool to parse Cobertura/OpenCover XML reports and render rich Spectre.Console coverage UIs or concise JSON summaries.</Description>
    <PackageTags>coverage;cobertura;opencover;spectre-console;dotnet-tool</PackageTags>
</PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Spectre.Console" Version="0.49.1" />
    <PackageReference Include="Spectre.Console.Cli" Version="0.49.1" />
  </ItemGroup>
  <!--  -->

</Project>
